# ---- Server ----
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---- Infra (matches docker-compose.yml) ----
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Slack OAuth (https://api.slack.com/apps). Redirect URL must be HTTPS, e.g. via ngrok ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-subdomain.ngrok-free.app/api/slack/oauth/callback

# ---- Ethereal senders ----
# Either list existing Ethereal accounts as user:pass pairs (comma separated)...
ETHEREAL_ACCOUNTS=
# ...or leave empty and this many accounts are auto-created on first boot.
ETHEREAL_SENDER_COUNT=3

# ---- Throughput / rate limiting ----
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (ms)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock hour (the compose "hourly limit" can only lower it per campaign)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Global safety valve across all workers/instances (BullMQ limiter)
QUEUE_LIMITER_MAX=50
QUEUE_LIMITER_DURATION_MS=1000
# How far ahead (hours) the rate limiter looks for a free window
RATE_LIMIT_MAX_LOOKAHEAD_HOURS=720
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# ---- Bull Board (optional basic auth; leave empty to disable) ----
BULL_BOARD_USER=
BULL_BOARD_PASS=
