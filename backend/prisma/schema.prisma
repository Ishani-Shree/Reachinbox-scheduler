generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String           @id @default(uuid())
  googleId  String           @unique
  email     String           @unique
  name      String
  avatarUrl String?
  createdAt DateTime         @default(now())
  campaigns Campaign[]
  emails    Email[]
  slack     SlackConnection?
}

/// An SMTP identity emails are sent from (Ethereal test accounts).
model Sender {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  emails    Email[]
}

/// One "Compose" submission: a subject/body sent to a list of recipients.
model Campaign {
  id              String   @id @default(uuid())
  userId          String
  senderId        String
  subject         String
  body            String   @db.Text
  startAt         DateTime
  delayBetweenMs  Int
  hourlyLimit     Int
  totalRecipients Int
  /// Client-supplied key so a retried or double-clicked submit never schedules twice.
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          Sender   @relation(fields: [senderId], references: [id])
  emails          Email[]
  attachments     Attachment[]

  @@unique([userId, idempotencyKey])
}

/// A file attached to every email of a campaign (stored once per campaign).
model Attachment {
  id          String   @id @default(uuid())
  campaignId  String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

/// One recipient of a campaign. Its id is also the BullMQ job id.
model Email {
  id                  String      @id @default(uuid())
  campaignId          String
  userId              String
  senderId            String
  toEmail             String
  subject             String
  body                String      @db.Text
  /// When the job will run next (moves forward if rate-limited).
  scheduledAt         DateTime
  /// When the user originally asked for it to go out.
  originalScheduledAt DateTime
  status              EmailStatus @default(SCHEDULED)
  sentAt              DateTime?
  messageId           String?
  previewUrl          String?
  error               String?
  attempts            Int         @default(0)
  deferredCount       Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  campaign            Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender              Sender      @relation(fields: [senderId], references: [id])

  @@unique([campaignId, toEmail])
  @@index([userId, status, scheduledAt])
  @@index([status])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  teamName    String
  channelId   String?
  channelName String?
  webhookUrl  String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
